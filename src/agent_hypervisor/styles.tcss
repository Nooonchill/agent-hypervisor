$bg: #07100c;
$surface: #101915;
$surface-hi: #16241d;
$line: #263d32;
$muted: #789083;
$text: #dcf5e7;
$green: #39d98a;
$amber: #f5bd52;

HypervisorDialog { align: center middle; background: transparent !important; }
#create-dialog, #session-dialog {
    width: 76; max-width: 95%; height: auto; max-height: 90%;
    padding: 1 2; border: solid $green;
    background: $surface;
}
#create-title, #session-title {
    height: auto; text-style: bold; color: $text; margin-bottom: 1;
}
#create-help, #session-help { height: auto; color: $muted; margin-bottom: 1; }
#create-actions { height: 3; align-horizontal: right; margin-top: 1; }
HypervisorDialog HypervisorButton {
    color: $green; background: $surface; border: solid $line;
}
#create-actions HypervisorButton { width: auto; min-width: 10; padding: 0 2; margin-left: 1; }
#session-dialog HypervisorButton { width: 1fr; margin-bottom: 1; }
.branch-presets { height: 3; margin-bottom: 1; }
.branch-presets HypervisorButton { width: 1fr; min-width: 8; margin-right: 1; }
HypervisorDialog HypervisorButton:hover, HypervisorDialog HypervisorButton:focus {
    color: $bg; background: $green; border: solid $green;
    text-style: bold; background-tint: transparent; tint: transparent;
}


    Screen { background: $bg; color: $text; }
    Header { background: #0d1712; color: $text; }
    Footer { background: #0d1712; color: $muted; }
    Tooltip { width: auto; height: auto; max-width: 60; padding: 1 2; }
    #workspace { height: 1fr; }
    #sidebar {
        width: 27; min-width: 27; background: #0b1510; border-right: solid $line;
        padding: 1;
    }
    #brand { height: 3; color: $green; text-style: bold; content-align: left middle; }
    #groups-label { height: 2; color: $muted; text-style: bold; }
    #groups { height: 1fr; background: transparent; }
    #groups ListItem { height: 3; padding: 0 1; color: #a9c4b5; content-align: left middle; }
    #groups ListItem Label { height: 1fr; content-align: left middle; }
    #groups ListItem.-highlight { background: #193528; color: #f0fff7; text-style: bold; }
    #group-actions { height: 3; margin-top: 1; align-horizontal: center; }
    .icon-button {
        width: 5; min-width: 5; height: 3; padding: 0; margin-right: 1;
        color: $green; background: $surface; border: solid $line; text-style: bold;
    }
    .icon-button:hover, .icon-button:focus {
        color: $bg; background: $green; border: solid $green;
        text-style: bold; background-tint: transparent; tint: transparent;
    }
    .icon-button:disabled {
        color: #496558; background: #0d1712; border: solid #1d3027;
    }
    #remove-group, #stop-button { margin-right: 0; }
    #main { width: 1fr; height: 1fr; padding: 1; }
    #group-header { height: 3; background: $surface; padding: 0 1; border: solid $line; }
    #group-title { width: 1fr; content-align: left middle; text-style: bold; }
    #group-state { width: auto; content-align: right middle; color: $green; }
    #terminal-grid { height: 1fr; overflow-y: auto; layout: grid; grid-size: 2 2; grid-columns: 1fr 1fr; grid-rows: 1fr 1fr; grid-gutter: 1; padding-top: 1; }
    .terminal-panel {
        background: #0a110e; color: #cce7d7; border: solid $line; padding: 0 1;
        overflow-x: hidden; overflow-y: auto; height: 1fr; min-height: 8; content-align: left top;
        scrollbar-size-vertical: 1; scrollbar-color: $green $surface;
    }
    .terminal-panel.selected { border: tall $green; background: #0d1712; }
    .terminal-panel.stopped { border: solid $amber; }
    #terminal-grid.fullscreen { grid-size: 1 1; grid-columns: 1fr; grid-rows: 1fr; }
    #terminal-grid.fullscreen .terminal-panel { column-span: 1; }
    #command-row { height: 3; margin-top: 1; align-horizontal: right; }
    #empty { height: 1fr; content-align: center middle; color: $muted; display: none; }
